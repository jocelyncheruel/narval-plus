{
  "manifest_version": 3,
  "name": "Narval+ — Espace étudiant",
  "version": "1.0.0",
  "description": "Une nouvelle façon de consulter Narval : suivi local et classement anonyme.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://narval.univ-ubs.fr/*", "https://narval-classement.onrender.com/*"],
  "content_scripts": [
    {
      "matches": ["https://narval.univ-ubs.fr/*"],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Ouvrir Narval+",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
